# Copy to deploy/prod/.env and edit. The real .env is git-ignored.

# REQUIRED. The address clients are told to reconnect to: the VM's public IP
# (or a hostname that resolves to it). Not "localhost", not a private IP.
KAFKA_ADVERTISED_HOST=

# Optional, shown with their defaults.
# KAFKA_ADVERTISED_PORT=9092
# KAFKA_NODE_ID=1

# Limits that bound what an unauthenticated client can use. See README.md,
# "Configuration". 200 partitions at 100 MB each is about 23 GB in the worst
# case, which fits the 50 GB boot disk of the free Oracle VM.
# KAFKA_MAX_PARTITIONS=200
# KAFKA_RETENTION_MAX_BYTES=104857600

# Only used with the "monitoring" profile: the Grafana admin password.
# Anonymous visitors are read-only; this is for you.
# GRAFANA_ADMIN_PASSWORD=
